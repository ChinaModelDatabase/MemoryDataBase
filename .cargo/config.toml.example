# cargo cross-build linker/CC configuration template.
# Copy to .cargo/config.toml when building for non-host targets.
# aws-lc-rs (via aws-lc-sys) honors CC_<target> env vars for the C compiler.

[target.aarch64-unknown-linux-gnu]
linker = "aarch64-linux-gnu-gcc"
# aws-lc-rs / aws-lc-sys C compiler:
# CC_aarch64_unknown_linux_gnu = "aarch64-linux-gnu-gcc"

[target.x86_64-unknown-linux-gnu]
linker = "x86_64-linux-gnu-gcc"
# aws-lc-rs / aws-lc-sys C compiler:
# CC_x86_64_unknown_linux_gnu = "x86_64-linux-gnu-gcc"

[target.loongarch64-unknown-linux-gnu]
linker = "loongarch64-linux-gnu-gcc"
# aws-lc-rs / aws-lc-sys C compiler:
# CC_loongarch64_unknown_linux_gnu = "loongarch64-linux-gnu-gcc"
